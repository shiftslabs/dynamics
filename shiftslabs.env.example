# Shiftslabs Business OS - Environment Configuration Example
# Copy this file to `shiftslabs.env` for local development.
# In production (e.g. Render), inject these as environment variables.
# NEVER commit the real `shiftslabs.env` with secrets to source control.

# Runtime
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
AUTH_SECRET=shiftslabs_super_secret_auth_key_at_least_32_chars_long

# Database (Neon PostgreSQL or local PostgreSQL)
DATABASE_URL=postgresql://shiftslabs_user:shiftslabs_password@localhost:5432/shiftslabs_db?schema=public
DIRECT_DATABASE_URL=postgresql://shiftslabs_user:shiftslabs_password@localhost:5432/shiftslabs_db?schema=public

# Paystack (Payments & Subscriptions)
PAYSTACK_SECRET_KEY=sk_test_example_shiftslabs_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_example_shiftslabs_public_key
PAYSTACK_WEBHOOK_SECRET=shiftslabs_paystack_webhook_signing_secret

# Email (Resend Transactional Email)
RESEND_API_KEY=re_example_shiftslabs_resend_api_key
RESEND_FROM_EMAIL="Shiftslabs <notifications@shiftslabs.com>"

# Object Storage (S3-Compatible e.g. Cloudflare R2 / AWS S3 / MinIO)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=shiftslabs-storage
S3_ACCESS_KEY_ID=example_r2_access_key_id
S3_SECRET_ACCESS_KEY=example_r2_secret_access_key
S3_PUBLIC_BASE_URL=https://media.shiftslabs.com

# Server-Side AI Provider Adapter
AI_PROVIDER=gemini
AI_API_KEY=example_gemini_or_openai_api_key
AI_BASE_URL=https://generativelanguage.googleapis.com
AI_MODEL=gemini-1.5-flash

# Web Push (VAPID Browser Push Notifications)
VAPID_PUBLIC_KEY=example_vapid_public_key_base64
VAPID_PRIVATE_KEY=example_vapid_private_key_base64
VAPID_SUBJECT=mailto:security@shiftslabs.com

# Real-time WebSocket Transport
REALTIME_PROVIDER=websocket
REALTIME_URL=ws://localhost:4000
REALTIME_PORT=4000

# Observability & Logging
LOG_LEVEL=info
ERROR_TRACKING_DSN=

# Background Job Scheduling
SCHEDULER_SECRET=shiftslabs_internal_scheduler_secret_token
WORKER_CONCURRENCY=5
