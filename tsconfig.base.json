{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@shiftslabs/database": ["./packages/database/src"],
      "@shiftslabs/database/*": ["./packages/database/src/*"],
      "@shiftslabs/auth": ["./packages/auth/src"],
      "@shiftslabs/auth/*": ["./packages/auth/src/*"],
      "@shiftslabs/permissions": ["./packages/permissions/src"],
      "@shiftslabs/permissions/*": ["./packages/permissions/src/*"],
      "@shiftslabs/validation": ["./packages/validation/src"],
      "@shiftslabs/validation/*": ["./packages/validation/src/*"],
      "@shiftslabs/config": ["./packages/config/src"],
      "@shiftslabs/config/*": ["./packages/config/src/*"],
      "@shiftslabs/ui": ["./packages/ui/src"],
      "@shiftslabs/ui/*": ["./packages/ui/src/*"],
      "@shiftslabs/business-core": ["./packages/business-core/src"],
      "@shiftslabs/business-core/*": ["./packages/business-core/src/*"],
      "@shiftslabs/profession-registry": ["./packages/profession-registry/src"],
      "@shiftslabs/profession-registry/*": ["./packages/profession-registry/src/*"],
      "@shiftslabs/customers": ["./packages/customers/src"],
      "@shiftslabs/customers/*": ["./packages/customers/src/*"],
      "@shiftslabs/scheduling": ["./packages/scheduling/src"],
      "@shiftslabs/scheduling/*": ["./packages/scheduling/src/*"],
      "@shiftslabs/work-orders": ["./packages/work-orders/src"],
      "@shiftslabs/work-orders/*": ["./packages/work-orders/src/*"],
      "@shiftslabs/catalogue": ["./packages/catalogue/src"],
      "@shiftslabs/catalogue/*": ["./packages/catalogue/src/*"],
      "@shiftslabs/inventory": ["./packages/inventory/src"],
      "@shiftslabs/inventory/*": ["./packages/inventory/src/*"],
      "@shiftslabs/purchasing": ["./packages/purchasing/src"],
      "@shiftslabs/purchasing/*": ["./packages/purchasing/src/*"],
      "@shiftslabs/commerce": ["./packages/commerce/src"],
      "@shiftslabs/commerce/*": ["./packages/commerce/src/*"],
      "@shiftslabs/finance": ["./packages/finance/src"],
      "@shiftslabs/finance/*": ["./packages/finance/src/*"],
      "@shiftslabs/documents": ["./packages/documents/src"],
      "@shiftslabs/documents/*": ["./packages/documents/src/*"],
      "@shiftslabs/billing": ["./packages/billing/src"],
      "@shiftslabs/billing/*": ["./packages/billing/src/*"],
      "@shiftslabs/metering": ["./packages/metering/src"],
      "@shiftslabs/metering/*": ["./packages/metering/src/*"],
      "@shiftslabs/storage": ["./packages/storage/src"],
      "@shiftslabs/storage/*": ["./packages/storage/src/*"],
      "@shiftslabs/notifications": ["./packages/notifications/src"],
      "@shiftslabs/notifications/*": ["./packages/notifications/src/*"],
      "@shiftslabs/realtime": ["./packages/realtime/src"],
      "@shiftslabs/realtime/*": ["./packages/realtime/src/*"],
      "@shiftslabs/intelligence": ["./packages/intelligence/src"],
      "@shiftslabs/intelligence/*": ["./packages/intelligence/src/*"],
      "@shiftslabs/reporting": ["./packages/reporting/src"],
      "@shiftslabs/reporting/*": ["./packages/reporting/src/*"],
      "@shiftslabs/support": ["./packages/support/src"],
      "@shiftslabs/support/*": ["./packages/support/src/*"],
      "@shiftslabs/advertising": ["./packages/advertising/src"],
      "@shiftslabs/advertising/*": ["./packages/advertising/src/*"],
      "@shiftslabs/audit": ["./packages/audit/src"],
      "@shiftslabs/audit/*": ["./packages/audit/src/*"],
      "@shiftslabs/observability": ["./packages/observability/src"],
      "@shiftslabs/observability/*": ["./packages/observability/src/*"],
      "@shiftslabs/testing": ["./packages/testing/src"],
      "@shiftslabs/testing/*": ["./packages/testing/src/*"]
    }
  },
  "exclude": ["node_modules"]
}
