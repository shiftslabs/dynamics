# DiscoverMe (Cloud8) - Environment Configuration
# Copy to .dev.vars for local Wrangler dev. Set production secrets via: wrangler secret put <NAME>

# Application
APP_URL=https://discoverme.shiftslabs.workers.dev
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/discoverme?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/discoverme?sslmode=require

# Auth
SESSION_SECRET=replace_with_a_secure_random_value_at_least_32_chars
AUTH_BASE_URL=http://localhost:8787

# S3-compatible storage
S3_ENDPOINT=https://your-s3-endpoint
S3_REGION=auto
S3_BUCKET=discoverme-media
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_PUBLIC_BASE_URL=https://media.example.com
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900
S3_MAX_UPLOAD_BYTES=10485760
S3_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,video/mp4

# Email (optional - implement provider adapter)
EMAIL_PROVIDER=
EMAIL_FROM="DiscoverMe <noreply@shiftslabs.com>"